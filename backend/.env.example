PORT=5000
# Checkout and cancellation require MongoDB transactions; use Atlas or another replica-set deployment.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/ecommerceDB?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=replace-with-a-long-random-secret

# Gmail SMTP: use your Gmail address and a Google App Password (not your Gmail login password).
EMAIL_USER=your-store@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password
# Optional display name and sender address; defaults to STORE_NAME <EMAIL_USER>.
EMAIL_FROM=
STORE_NAME=Brand Store
